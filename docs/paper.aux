\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}KNN 的邻居选择}{4}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces 实验 4 在 $\eta {=}0.02$ 下的决策边界。左子图为真实标签，中间为 KNN，右子图是 SVM。空心三角为注入训练集的翻转点，按观测标签着色，KNN 的边界只在错标点附近出现变化，SVM 的超平面则整体向错标方向偏转，虚线为真实边界 $x_1+0.5x_2=0$。}}{5}{}\protected@file@percent }
\newlabel{fig:exp4}{{4}{5}{}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces KNN 实例级邻居选择。黑色虚线圆表示直至第 $k$ 近邻的邻域半径。左子图采用均匀投票，预测为红色，分类错误。右子图采用距离加权，预测为蓝色，分类正确。}}{5}{}\protected@file@percent }
\newlabel{fig:exp5nb}{{5}{5}{}{figure.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}SVM 的间隔与 $C$}{5}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces KNN 按 $k$ 扫描。从左到右依次为 $k{=}1$、11、21，训练标签含 8\% 随机翻转。$k{=}1$ 时模型会追逐翻转点，从而出现一个个孤岛。从评价指标来看，$k{=}21$ 最好，$k{=}11$ 略低。}}{6}{}\protected@file@percent }
\newlabel{fig:exp5k}{{6}{6}{}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces SVM 间隔。实线为超平面，虚线为间隔边界 $w\cdot x+b=\pm 1$，阴影为间隔带，空心圈为支持向量，共 9 个，间隔宽 $2/\lVert w\rVert =1.22$。}}{6}{}\protected@file@percent }
\newlabel{fig:exp6m}{{7}{6}{}{figure.7}{}}
